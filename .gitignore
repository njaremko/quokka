# Buck2 / Cargo build outputs
/buck-out
/target
/third-party/target

# reindeer's download cache (CARGO_HOME side-effect; not a build input). Crates
# are fetched via http_archive at build time, so nothing under third-party is
# vendored into the repo.
/third-party/.cargo
/third-party/vendor

# Runner's default duration/flake DB (written next to the built binary)
/quokka-db
/.tmp

# devenv / direnv
/.devenv
/.devenv.flake.nix
/.direnv

# macOS
.DS_Store
**/.DS_Store
